EDGE_ENV=production
DEVICE_ID=pi-edge-01
SITE_ID=factory-a
LINE_ID=line-1

# CloudAMQP uplink used only by this Pi gateway. Use the MQTT/TLS host,
# port 8883 and credentials shown by the CloudAMQP console; never copy these
# values to the ESP32 or machine controllers.
MQTT_HOST=CHANGE_ME_CLOUDAMQP_MQTT_HOST
MQTT_PORT=8883
MQTT_USERNAME=CHANGE_ME_CLOUDAMQP_MQTT_USERNAME
MQTT_PASSWORD=CHANGE_ME_CLOUDAMQP_MQTT_PASSWORD
MQTT_USE_TLS=true
# CloudAMQP normally chains to a public CA already trusted by the OS.
MQTT_CA_CERT=
MQTT_CLIENT_ID=pi-edge-01

# Local Mosquitto gateway ingress for ESP32/WROVER sensors. Port 1883 is
# loopback only for Python; devices connect to Pi TLS listener 8883 directly.
LOCAL_MQTT_ENABLED=true
LOCAL_MQTT_HOST=127.0.0.1
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_USERNAME=smartfactory-gateway
LOCAL_MQTT_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_GATEWAY_PASSWORD
LOCAL_MQTT_USE_TLS=false
LOCAL_MQTT_CA_CERT=
LOCAL_MQTT_CLIENT_ID=pi-edge-ingress
# Exact WROVER device IDs permitted by the Python forwarder; comma-separated.
LOCAL_MQTT_DEVICE_IDS=esp32-wrover-01
# Separate allowlist for remote GPIO pulse requests; keep empty until the
# WROVER control output and isolated driver wiring have been commissioned.
LOCAL_MQTT_CONTROL_DEVICE_IDS=

# ADA031 V4 command control is disabled by default. After verifying the
# exact arm, clears, source limits and first USB-open motion, add only its AAS
# asset ID here. Fixed UI actions send one connected-firmware byte, and the
# same serial owner reads its controller telemetry.
ADA031_CONTROL_ASSET_IDS=

# Standalone serial JSON sensor input. An AAS serial asset reserves its matching device path.
SERIAL_ENABLED=false
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
ASSET_CONFIG_FILE=/var/lib/smart-factory-iot/assets.json
ASSET_POLL_INTERVAL_SECONDS=0.5
SYNTHETIC_TELEMETRY_ENABLED=false

# OPC UA secure channel is required unless explicitly overridden for a lab.
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_SECURITY_POLICY=Basic256Sha256
OPCUA_SECURITY_MODE=SignAndEncrypt
OPCUA_CLIENT_CERT=/etc/smart-factory-iot/certs/opcua-client-cert.pem
OPCUA_CLIENT_KEY=/etc/smart-factory-iot/certs/opcua-client-key.pem
OPCUA_SERVER_CERT=
OPCUA_ALLOW_INSECURE=false

# Independent industrial tags and read-only OPC UA FX / TSN observation.
# This desired-state document has a separate retained /commands/connectivity route.
CONNECTIVITY_CONFIG_FILE=/var/lib/smart-factory-iot/connectivity.json
# Production requires explicit commissioned destinations/resources. Empty denies.
CONNECTIVITY_ALLOWED_NETWORKS=
CONNECTIVITY_ALLOWED_HOSTS=
CONNECTIVITY_ALLOWED_SERIAL_PORTS=
CONNECTIVITY_ALLOWED_INTERFACES=
# Local owner-only JSON of credential / TSN collector references; never sent by MQTT.
CONNECTIVITY_SECRETS_FILE=
# Poll/subscription intervals are per connection; cloud reporting is separately bounded.
CONNECTIVITY_REPORT_INTERVAL_SECONDS=10
CONNECTIVITY_SNAPSHOT_SECONDS=30

PUBLISH_INTERVAL_SECONDS=5
# Preserve every value/status/button change; coalesce identical live samples.
# Historical replay is forwarded unchanged. No temperature/humidity deadband.
TELEMETRY_COALESCING_ENABLED=true
TELEMETRY_SNAPSHOT_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=60

# Production systemd creates a private writable state directory.
EDGE_STATE_DIR=/var/lib/smart-factory-iot
MAX_QUEUED_MESSAGES=50000

# Optional read-only security observation; commission manually after staging.
SECURITY_COLLECTOR_ENABLED=false
# SECURITY_API_ORIGIN=https://your-smart-factory-api.example
# SECURITY_SOURCE_TOKEN=<one-time scoped key from private Cybersecurity admin>
# SECURITY_PRODUCER_NAMESPACE=reviewed-gateway-namespace
# SECURITY_INTERVAL_SECONDS=300
# SECURITY_MODE=simulated
# SECURITY_RUN_ID=staging-commission-001
